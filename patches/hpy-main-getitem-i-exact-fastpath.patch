diff --git a/hpy/devel/src/runtime/ctx_object.c b/hpy/devel/src/runtime/ctx_object.c
index 9fa72a2..c974c2a 100644
--- a/hpy/devel/src/runtime/ctx_object.c
+++ b/hpy/devel/src/runtime/ctx_object.c
@@ -43,6 +43,34 @@ ctx_Is(HPyContext *ctx, HPy h_obj, HPy h_other)
 _HPy_HIDDEN HPy
 ctx_GetItem_i(HPyContext *ctx, HPy obj, HPy_ssize_t idx) {
     PyObject *py_obj = _h2py(obj);
+#ifndef Py_GIL_DISABLED
+    if (PyList_CheckExact(py_obj)) {
+        Py_ssize_t size = PyList_GET_SIZE(py_obj);
+        PyObject *item;
+        if (idx < 0)
+            idx += size;
+        if (idx < 0 || idx >= size) {
+            PyErr_SetString(PyExc_IndexError, "list index out of range");
+            return HPy_NULL;
+        }
+        item = PyList_GET_ITEM(py_obj, idx);
+        Py_INCREF(item);
+        return _py2h(item);
+    }
+#endif
+    if (PyTuple_CheckExact(py_obj)) {
+        Py_ssize_t size = PyTuple_GET_SIZE(py_obj);
+        PyObject *item;
+        if (idx < 0)
+            idx += size;
+        if (idx < 0 || idx >= size) {
+            PyErr_SetString(PyExc_IndexError, "tuple index out of range");
+            return HPy_NULL;
+        }
+        item = PyTuple_GET_ITEM(py_obj, idx);
+        Py_INCREF(item);
+        return _py2h(item);
+    }
     if (PySequence_Check(py_obj)) {
         return _py2h(PySequence_GetItem(py_obj, idx));
     }
