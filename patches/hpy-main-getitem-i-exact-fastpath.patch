+    def test_getitem_i_sequence_semantics(self):
+        import pytest
+        mod = self.make_module("""
+            HPyDef_METH(f, "f", HPyFunc_O)
+            static HPy f_impl(HPyContext *ctx, HPy self, HPy arg)
+            {
+                return HPy_GetItem_i(ctx, arg, -1);
+            }
+            @EXPORT(f)
+            @INIT
+        """)
+
+        assert mod.f(["first", "last"]) == "last"
+        assert mod.f(("first", "last")) == "last"
+        with pytest.raises(IndexError):
+            mod.f([])
+        with pytest.raises(IndexError):
+            mod.f(())
+
+        class CustomList(list):
+            def __getitem__(self, key):
+                return ("list override", key)
+
+        class CustomTuple(tuple):
+            def __getitem__(self, key):
+                return ("tuple override", key)
+
+        assert mod.f(CustomList()) == ("list override", -1)
+        assert mod.f(CustomTuple()) == ("tuple override", -1)
+
